# Cloudflare Web Analytics token. Inlined into the production HTML by
# Vite/Astro at build time (PUBLIC_* prefix exposes it to the client).
# Leave unset in dev — the analytics beacon only renders when both
# import.meta.env.PROD and this token are present.
#
# Get a token: Cloudflare Dashboard → Web Analytics → Add a site → copy
# the value from the data-cf-beacon JSON.
PUBLIC_CF_ANALYTICS_TOKEN=
