---
import { Image } from 'astro:assets';
import MiniTabs from './MiniTabs.astro';
import {
  MockMaps, MockMessages, MockMusic, MockSafari, MockNotes,
} from './MockScreens.jsx';
import pCafe from '../assets/images/p-cafe.png';
import pBedroomNight from '../assets/images/p-bedroom-night.png';
import pKitchenWarm from '../assets/images/p-kitchen-warm.png';
import pCityDawn from '../assets/images/p-city-dawn.png';
import pNightPhone from '../assets/images/p-night-phone.png';

const recent = [
  { src: pCafe,         alt: 'cafe',          Mock: MockMaps },
  { src: pBedroomNight, alt: 'bedroom',       Mock: MockMessages },
  { src: pKitchenWarm,  alt: 'kitchen',       Mock: MockMusic },
  { src: pCityDawn,     alt: 'city dawn',     Mock: MockSafari },
  { src: pNightPhone,   alt: 'phone night',   Mock: MockNotes },
];
const thumbWidths = [64, 128];
---
<div class="lp-screen lp-home">
  <h2 class="lp-mast"><em>screengram</em>.</h2>

  <div class="lp-recent">
    {recent.map(({ src, alt, Mock }) => (
      <div class="lp-rcell">
        <Image src={src} alt={alt} widths={thumbWidths} formats={['avif', 'webp']} quality={55} class="lp-rcell-bg" />
        <div class="lp-rcell-pip"><Mock /></div>
      </div>
    ))}
  </div>

  <div class="lp-prompt">
    <div class="lp-prompt-h">
      <span class="lp-dot"></span>
      <span class="mono">today's prompt · day 47</span>
      <span class="lp-prompt-spacer"></span>
      <span class="lp-prompt-shuf" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1.4">
          <path d="M3 4h2.5l5 8H13M3 12h2.5l5-8H13" />
          <path d="M11 2l2 2-2 2M11 10l2 2-2 2" />
        </svg>
      </span>
    </div>
    <div class="lp-prompt-t">the alarm + you ignoring it</div>
    <div class="lp-prompt-row">
      <span class="lp-take">
        <span class="lp-take-d"></span>
        <span>take it</span>
      </span>
      <span class="lp-skip mono">skip</span>
    </div>
  </div>

  <div class="lp-go-wrap">
    <button class="lp-go" aria-label="Go" type="button">
      <span class="lp-go-ring"></span>
      <span class="lp-go-core">GO</span>
    </button>
  </div>

  <div class="lp-latest">
    <div class="lp-latest-thumb">
      <Image src={pCafe} alt="" widths={thumbWidths} formats={['avif', 'webp']} quality={55} class="lp-latest-thumb-bg" />
      <div class="lp-latest-thumb-pip"><MockMaps /></div>
    </div>
    <div class="lp-latest-txt">
      <div class="mono lp-latest-k">use latest</div>
      <div class="lp-latest-s">taken just now</div>
    </div>
    <div class="lp-latest-arr">→</div>
  </div>

  <MiniTabs on="home" />
</div>
