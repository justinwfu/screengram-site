---
import PhoneFrame from './PhoneFrame.astro';
import HomeScreen from './HomeScreen.astro';
import CamScreen from './CamScreen.astro';
import LibraryScreen from './LibraryScreen.astro';

type Kind = 'home' | 'cam' | 'library';

interface Step {
  label: string;
  kind: Kind;
  headline: string;
  body: string;
}

const steps: Step[] = [
  {
    label: 'home',
    kind: 'home',
    headline: 'take a screenshot.',
    body: 'Anywhere on iOS — a recipe, a map, a tweet, a passage. Open Screengram. The Home screen already knows you took one.',
  },
  {
    label: 'camera',
    kind: 'cam',
    headline: 'take a photo with the screenshot in it.',
    body: 'The back camera opens with a translucent overlay of the screenshot floating in the viewfinder. Drag it, pinch to resize, anchor to a corner. Frame the room. Tap the shutter.',
  },
  {
    label: 'library',
    kind: 'library',
    headline: 'it lands in your archive.',
    body: 'Search by caption or place. Filter by month or album. Tap any tile to open the detail view — share, export a reveal reel, or add it to an album.',
  },
];
---
<section class="loop">
  <div class="section-h">
    <div class="mono small">— the loop —</div>
    <h2>screenshot → pic → library.</h2>
    <p class="section-sub">It takes about eight seconds. We timed it.</p>
  </div>
  <div class="loop-stack">
    {steps.map((s, i) => (
      <div class={'loop-row ' + (i % 2 ? 'reverse' : '')}>
        <div class="loop-phone">
          <PhoneFrame>
            {s.kind === 'home' && <HomeScreen />}
            {s.kind === 'cam' && <CamScreen />}
            {s.kind === 'library' && <LibraryScreen />}
          </PhoneFrame>
          <div class="loop-tag mono">{s.label}</div>
        </div>
        <div class="loop-copy">
          <div class="loop-step mono small">step 0{i + 1}</div>
          <h3>{s.headline}</h3>
          <p>{s.body}</p>
        </div>
      </div>
    ))}
  </div>
</section>
