---
const features = [
  { ico: '☼', h: 'daily prompt',
    b: 'A Wordle-shaped nudge. One screengram a day, one shared question.' },
  { ico: '▶', h: 'reveal reels',
    b: 'Export a tiny video where the room dissolves to reveal the screenshot. 1080×1920, h.264.' },
  { ico: '◉', h: 'widget + share sheet',
    b: 'Latest screengram on your home screen. Send a screenshot in from anywhere.' },
  { ico: '⊘', h: 'private, searchable',
    b: 'No feed. No cloud. Lives on your phone — search by caption, place, or month.' },
];
---
<section class="features" id="features">
  <div class="section-h feat-h">
    <div class="mono small">— what's inside —</div>
    <h2><span>small app.</span><br /><span>big rectangle energy.</span></h2>
  </div>
  <div class="feat-grid">
    {features.map((it) => (
      <div class="feat-card">
        <div class="feat-ico">{it.ico}</div>
        <h3>{it.h}</h3>
        <p>{it.b}</p>
      </div>
    ))}
  </div>
</section>
