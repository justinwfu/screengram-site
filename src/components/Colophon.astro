---
interface Props {
  issueNumber?: string;
}

const { issueNumber = '01' } = Astro.props;
---

<footer class="colo">
  <div class="colo-row mono small">
    <div>
      <div class="colo-k">PUBLISHER</div>
      <div class="colo-v">screengram press</div>
    </div>
    <div>
      <div class="colo-k">VOLUME</div>
      <div class="colo-v">{issueNumber} of ∞</div>
    </div>
    <div>
      <div class="colo-k">SET IN</div>
      <div class="colo-v">newsreader &amp; jetbrains mono</div>
    </div>
    <div>
      <div class="colo-k">PRINTED</div>
      <div class="colo-v">on a rectangle</div>
    </div>
  </div>
  <div class="colo-tag">
    <em>What you were looking at, and where you were while you looked at it.</em>
  </div>
</footer>
