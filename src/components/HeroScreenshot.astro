---
import { Image } from 'astro:assets';
import volScreen from '../assets/vol-1-screen.png';
---

<div class="phone-frame">
  <div class="phone-frame-inner">
    <Image
      src={volScreen}
      alt=""
      class="hero-screen-img"
      widths={[200, 320, 480, 640]}
      sizes="26vw"
      format="avif"
      quality={75}
      loading="eager"
    />
    <div class="phone-island"></div>
  </div>
</div>
