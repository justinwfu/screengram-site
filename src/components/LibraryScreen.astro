---
import { Image } from 'astro:assets';
import MiniTabs from './MiniTabs.astro';
import {
  MockPhotos, MockCalendar, MockSafari, MockNotes, MockMusic, MockMessages,
} from './MockScreens.jsx';
import pCafe from '../assets/images/p-cafe.png';
import pBedroomNight from '../assets/images/p-bedroom-night.png';
import pKitchenWarm from '../assets/images/p-kitchen-warm.png';
import pCityDawn from '../assets/images/p-city-dawn.png';
import pNightPhone from '../assets/images/p-night-phone.png';
import pStreetNight from '../assets/images/p-street-night.png';

const tiles = [
  { src: pCafe,         alt: 'cafe',         Mock: MockPhotos },
  { src: pBedroomNight, alt: 'bedroom',      Mock: MockCalendar },
  { src: pKitchenWarm,  alt: 'kitchen',      Mock: MockSafari },
  { src: pCityDawn,     alt: 'city dawn',    Mock: MockNotes },
  { src: pNightPhone,   alt: 'phone night',  Mock: MockMusic },
  { src: pStreetNight,  alt: 'street night', Mock: MockMessages },
];
const tileWidths = [160, 320];
---
<div class="lp-screen lp-lib">
  <div class="lp-lib-head">
    <div class="lp-lib-title">library</div>
    <div class="mono lp-lib-count">7 screengrams</div>
  </div>

  <div class="lp-lib-search mono">
    <span class="lp-lib-search-i">⌕</span>
    <span class="lp-lib-search-p">search captions, places</span>
  </div>

  <div class="lp-lib-chips">
    <span class="lp-chip mono">by album</span>
    <span class="lp-chip mono">by month</span>
  </div>

  <div class="lp-lib-grid">
    {tiles.map(({ src, alt, Mock }) => (
      <div class="lp-lcell">
        <Image src={src} alt={alt} widths={tileWidths} formats={['avif', 'webp']} quality={55} class="lp-lcell-bg" />
        <div class="lp-lcell-pip"><Mock /></div>
      </div>
    ))}
  </div>

  <MiniTabs on="library" />
</div>
