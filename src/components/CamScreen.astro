---
import { Image } from 'astro:assets';
import { MockSafari } from './MockScreens.jsx';
import pCityDawn from '../assets/images/p-city-dawn.png';
---
<div class="lp-screen lp-cam">
  <div class="lp-vf">
    <Image src={pCityDawn} alt="" widths={[240, 480]} formats={['avif', 'webp']} quality={60} class="lp-vf-photo-img" />
    <div class="lp-vf-photo-wash" aria-hidden="true"></div>

    <div class="lp-vf-corners">
      <span></span><span></span><span></span><span></span>
    </div>

    <div class="lp-vf-shot">
      <div class="lp-vf-shot-frame"><MockSafari /></div>
      <div class="lp-vf-shot-tip mono">drag · pinch</div>
    </div>

    <div class="lp-vf-chip mono">
      <span class="lp-vf-chip-d" data-on="1"></span>
      <span>overlay on</span>
    </div>
    <div class="lp-vf-pill mono">
      <span class="lp-dot"></span>
      <span>frame the room</span>
    </div>
  </div>

  <div class="lp-cam-ctrls">
    <div class="lp-cam-side mono">retake<br />screen</div>
    <div class="lp-cam-shutter">
      <span class="lp-cam-shutter-ring"></span>
      <span class="lp-cam-shutter-core"></span>
    </div>
    <div class="lp-cam-side mono">zoom<br />+/−</div>
  </div>
</div>
