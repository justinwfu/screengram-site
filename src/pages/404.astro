---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404" description="The page you're looking for isn't here." noindex>
  <main class="page" style="min-height: 70vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 16px;">
    <div class="mono small" style="color: var(--accent); letter-spacing: 0.16em; text-transform: uppercase;">— 404 —</div>
    <h1 class="word" style="font-family: Newsreader, serif; font-style: italic; font-weight: 400; letter-spacing: -0.04em; font-size: clamp(72px, 14vw, 196px); line-height: 0.92; color: var(--ink); margin: 0;">
      lost the page.
    </h1>
    <p style="color: var(--faded); font-family: Newsreader, serif; font-size: 22px; line-height: 1.42; max-width: 36ch;">
      <em>What you were looking at, and where you were while you looked at it</em> — but not this URL.
    </p>
    <a href="/" class="cta-btn" style="margin-top: 12px;">
      <span>back to the front page</span>
      <span class="arr">↗</span>
    </a>
  </main>
</Layout>
